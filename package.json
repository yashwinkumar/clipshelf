    "bundle": "tauri build --bundles app --config src-tauri/bundle.config.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashwinkumar/clipshelf.git"
  }
}
