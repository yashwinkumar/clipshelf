{
  "name": "clipshelf",
  "private": true,
  "version": "0.1.0",
  "description": "Clipshelf: a clipboard history app for macOS built with Tauri and Rust.",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
